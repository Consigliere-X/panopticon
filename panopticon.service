[Unit]
Description=Panopticon privacy telemetry watcher
After=network.target

[Service]
Type=simple
ExecStart=/home/lordsilencio/Projects/panopticon/target/release/panopticon --watch
WorkingDirectory=/home/lordsilencio/Projects/panopticon
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_DAC_READ_SEARCH
Restart=on-failure
Nice=10

[Install]
WantedBy=multi-user.target
